{
  "name": "@searyanc/rtrace",
  "version": "0.3.0",
  "description": "A minimal Rust library with Node.js bindings",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "rtrace": "dist/rtrace.js"
  },
  "files": [
    "dist/"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./schema": "./dist/schema/index.js"
  },
  "scripts": {
    "build": "npx hereby build",
    "build:node": "npx hereby build:node",
    "build:node:platform": "npx napi build --platform --release --cargo-cwd bindings/node dist",
    "build:schema": "npx hereby schema:compile",
    "build:wrapper": "npx hereby build:wrapper",
    "build:all": "npx hereby build:all",
    "test": "npx hereby test:node",
    "test:all": "npx hereby test:all",
    "example": "npx hereby example",
    "hereby": "hereby",
    "task": "hereby",
    "tasks": "hereby --list",
    "schema:compile": "npx hereby schema:compile",
    "schema:generate": "npx hereby schema:generate",
    "schema:validate": "npx hereby schema:validate",
    "schema:all": "npx hereby schema:all",
    "editor:prepare": "npm run schema:generate && node scripts/prepare-editor.mjs",
    "editor:build": "npm run editor:prepare && npx tsc -p editor/tsconfig.json && node scripts/copy-editor-assets.mjs",
    "editor:start": "npm run editor:build && electron editor/dist/main.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SeaRyanC/rtrace.git"
  },
  "keywords": [
    "rust",
    "nodejs",
    "bindings"
  ],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/SeaRyanC/rtrace/issues"
  },
  "homepage": "https://github.com/SeaRyanC/rtrace#readme",
  "napi": {
    "name": "index",
    "triples": {
      "defaults": true
    }
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.4",
    "@types/node": "^24.3.3",
    "electron": "^38.1.0",
    "hereby": "^1.11.0",
    "typescript": "^5.9.2",
    "zod": "^4.1.8"
  },
  "dependencies": {
    "monaco-editor": "^0.52.2",
    "pngjs": "^7.0.0"
  }
}
