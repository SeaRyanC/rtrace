{
  "name": "rtrace",
  "version": "0.1.0",
  "description": "A minimal Rust library with Node.js bindings",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "npm run build:node && npm run build:schema && npm run build:copy",
    "build:node": "napi build --release --cargo-cwd bindings/node tracer",
    "build:schema": "tsc",
    "build:copy": "node scripts/copy-build-outputs.js",
    "test": "npm run build && node scripts/test.js",
    "example": "npm run build && node scripts/example.js",
    "hereby": "hereby",
    "task": "hereby",
    "tasks": "hereby --list",
    "schema:compile": "npm run build:schema",
    "schema:generate": "npm run build:schema && node dist/schema/validate-schema.js --generate-schema",
    "schema:validate": "npm run build:schema && node dist/schema/validate-schema.js --validate",
    "schema:all": "npm run schema:generate && npm run schema:validate"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SeaRyanC/rtrace.git"
  },
  "keywords": [
    "rust",
    "nodejs",
    "bindings"
  ],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/SeaRyanC/rtrace/issues"
  },
  "homepage": "https://github.com/SeaRyanC/rtrace#readme",
  "napi": {
    "name": "rtrace",
    "triples": {
      "defaults": true
    }
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.4",
    "@types/node": "^24.3.3",
    "hereby": "^1.11.0",
    "typescript": "^5.9.2",
    "zod": "^4.1.8"
  },
  "dependencies": {
    "pngjs": "^7.0.0"
  }
}
