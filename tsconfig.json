{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "declaration": true,
    "outDir": "./dist/schema",
    "rootDir": "./ts-schema",
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "ts-schema/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "schema",
    "target"
  ]
}